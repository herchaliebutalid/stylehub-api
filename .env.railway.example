# ========================================
# STYLEHUB - RAILWAY PRODUCTION TEMPLATE
# ========================================
# Do not put real passwords or API keys here.
# Actual values will be configured in Railway.
# This file is NOT used by local Laravel.

# APPLICATION
APP_NAME=StyleHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en

# LOGGING
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MYSQL DATABASE
# References assume the Railway service is named MySQL.
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# DATABASE QUEUE AND CACHE
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# SESSION SECURITY
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# FILE STORAGE
FILESYSTEM_DISK=local

# ADMINISTRATOR WEB ORIGIN
CORS_ALLOWED_ORIGINS=

# EMAIL
MAIL_MAILER=log

# TEXTBEE SMS
# Keep normal SMS disabled until we finish testing.
SMS_ENABLED=false
SMS_LIVE_TEST_ENABLED=false

TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_ENDPOINT=https://api.textbee.dev/api/v1/gateway/send-sms

# SMS REMINDERS
SMS_REMINDER_LEAD_MINUTES=1440
SMS_REMINDER_MINIMUM_LEAD_MINUTES=60

# SMS RECOVERY
SMS_PENDING_RECOVERY_MINUTES=5
SMS_PROCESSING_RECOVERY_MINUTES=10